---
import "@/styles/global.css";
import MainLayout from "@/layouts/MainLayout.tsx";
import HomeHero from "@/components/hero/HomeHero.tsx";
import WhatWeDo from "@/components/sections/home/WhatWeDo.tsx";
import WhoWeAre from "@/components/sections/home/WhoWeAre.tsx";
import WhyFinancialMatters from "@/components/sections/home/WhyFinancialMatters.tsx";
import Testimonials from "@/components/sections/home/Testimonials.tsx";
import CTA from "@/components/sections/home/CTA.tsx";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ac1212" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/teamca-white-circle-logo.png" />
    <title>Home | Team CA</title>
  </head>
  <body>
    <MainLayout client:load>
      <HomeHero />
      <WhoWeAre />
      <WhatWeDo />
      <WhyFinancialMatters />
      <Testimonials />
      <CTA />
    </MainLayout>
  </body>
</html>
