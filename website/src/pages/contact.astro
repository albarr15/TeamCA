---
import "@/styles/global.css";
import MainLayout from "@/layouts/MainLayout.tsx";
import ContactHero from "@/components/hero/ContactHero.tsx";
import ContactDetails from "@/components/sections/contact/ContactDetails.tsx";
import ConsultationForm from "@/components/sections/appointment/Consultation.astro";
import { Toaster } from "@/components/starwind/toast";
import "@/styles/starwind.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#ac1212" />
    <meta
      name="description"
      content="Contact Team CA - Pru Life UK Financial Planning & Advisory. Reach our office at Antel Global Corporate Center, Ortigas, Pasig."
    />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/teamca-white-circle-logo.png" />
    <link rel="icon" type="image/png" href="/icons/teamca-white-circle-logo.png" />
    <title>Contact Us | Team CA</title>
  </head>
  <body>
    <MainLayout client:load>
      <ContactHero client:load />
      <ContactDetails client:load />
      <ConsultationForm />
      <Toaster position="bottom-right" />
    </MainLayout>
  </body>
</html>
