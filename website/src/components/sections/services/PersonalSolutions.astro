---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

import { AspectRatio } from "@/components/starwind/aspect-ratio";

import { HouseHeart } from "lucide-react";

import { HeartHandshake, HouseHeartIcon, type LucideIcon } from "lucide-react";
import { Card, CardContent } from "@/components/starwind/card";

interface Props extends HTMLAttributes<"section"> {
    /** Main heading text */
    heading?: string;
    /** Description text */
    description?: string;
    /** Personal Solutions list */
    solutions: {
        title: string;
        description: string;
        icon: LucideIcon;
    }[];
}

const solContainerStyles = tv({
    base: "@container py-20 px-6 md:px-12 lg:px-20 w-full items-center flex flex-col",
});

const {
    heading,
    description,
    solutions,
    class: className,
    ...rest
} = Astro.props;
---

<section class={solContainerStyles({ class: className })} {...rest}>
    <div class="flex flex-col items-center w-full max-w-7xl">
        <!-- HEADER -->
        <div class="flex flex-col items-center text-center max-w-3xl">
            <h1
                class="font-heading text-4xl font-semibold tracking-tight @4xl:text-5xl"
            >
                {heading}
            </h1>

            <p class="text-muted-foreground mt-6 text-lg max-w-2xl">
                {description}
            </p>
        </div>

        <!-- SOLUTIONS -->
        <div class="w-full mt-12 grid gap-4 @2xl:grid-cols-3 @2xl:gap-4">
            {
                solutions.map((item, index) => {
                    const Icon = item.icon;
                    return (
                        <Card interactive>
                            <CardContent class="flex flex-col gap-4">
                                <div class="flex gap-4">
                                    <div class="rounded-full bg-primary p-2 shadow-md shadow-primary/20 h-fit w-fit shrink-0">
                                        <Icon className="text-primary-foreground" />
                                    </div>
                                    <div class="font-medium text-xl">
                                        {item.title}
                                    </div>
                                </div>
                                <blockquote class="text-muted-foreground leading-relaxed">
                                    {item.description}
                                </blockquote>
                            </CardContent>
                        </Card>
                    );
                })
            }
        </div>
    </div>
</section>
